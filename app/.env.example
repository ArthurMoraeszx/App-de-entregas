# Endereco da API. Vale na hora do build/start do Expo.
#
#   Web (npm run web) ................ localhost funciona
#   Celular via Expo Go .............. troque pelo IP da sua maquina na rede,
#                                      o mesmo que o servidor imprime ao subir.
#                                      Ex.: http://192.168.0.100:3001/api/
EXPO_PUBLIC_API_URL=http://localhost:3001/api/

# Aparece nos diagnosticos enviados ao servidor. Manter igual ao "version" do app.json.
EXPO_PUBLIC_APP_VERSION=1.0.0
