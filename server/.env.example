# Copie este arquivo para .env e ajuste se precisar.
# Os valores abaixo ja funcionam para desenvolvimento local.

PORT=3001

# Segredos JWT — troque por qualquer string longa e aleatoria.
JWT_SECRET=troque-este-segredo-em-producao-1234567890
JWT_REFRESH_SECRET=troque-este-outro-segredo-em-producao-0987654321

# Validade dos tokens
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=15d

# Caminho do banco SQLite (relativo a pasta server/)
DB_FILE=./data/rotaescolar.db

# Pasta onde as fotos das guias sao gravadas
UPLOADS_DIR=./uploads

# Origens liberadas no CORS. * libera tudo (ok em desenvolvimento).
CORS_ORIGIN=*
